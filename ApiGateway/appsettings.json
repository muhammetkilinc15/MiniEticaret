{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Muhammet kilinc",
    "Audience": "www.bilmemne.com.tr",
    "SecretKey": "Babalar_sözünü_tuttar ama bazen babalar baba olmayı bilmez"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgress": "Host=host.docker.internal;Port=5433;Database=usersDb;Username=postgres;Password=1;"
  },
  "ReverseProxy": {
    "Routes": {
      "productsRoute": {
        "ClusterId": "productsCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "shoppingCartsRoute": {
        "ClusterId": "shoppingCartsCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/carts/{**catch-all}"
        }
      },
      "orderssRoute": {
        "ClusterId": "ordersCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "productsCluster": {
        "Destinations": {
          "productsDestination": {
            "Address": "http://products:8080/"
          }
        }
      },
      "shoppingCartsCluster": {
        "Destinations": {
          "shoppingCartsDestination": {
            "Address": "http://carts:8080/"
          }
        }
      },
      "ordersCluster": {
        "Destinations": {
          "ordersDestination": {
            "Address": "http://orders:8080/"
          }
        }
      }
    }
  }
}
